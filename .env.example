POSTGRES_USER=your_postgres_user
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_DB=haadthip_procurement
POSTGRES_PORT=5432

# Local example:
# DATABASE_URL=postgresql://your_postgres_user:your_postgres_password@localhost:5432/haadthip_procurement?schema=public
#
# Hosted example for Vercel:
# DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require
DATABASE_URL=postgresql://your_postgres_user:your_postgres_password@localhost:5432/haadthip_procurement?schema=public

# Local dev URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Used only by the Docker/container startup script, not by Vercel deployments.
SEED_ON_START=false
